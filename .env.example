# ═══════════════════════════════════════════════════════
# GoRASA CockroachDB Standalone — Environment Variables
# ═══════════════════════════════════════════════════════
#
# TWO ISOLATED DATABASE ENVIRONMENTS:
#   DEV  → .env.local      (local dev + cckr.vercel.app)
#   PROD → .env.production  (project-yidb6.vercel.app)
#
# Each environment MUST use a DIFFERENT CockroachDB cluster
# to ensure complete data isolation.

# ───────────────────────────────────────────────────────
# CockroachDB — DEV Cluster
# ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@dev-cluster:26257/defaultdb?sslmode=verify-full
DIRECT_URL=postgresql://user:password@dev-cluster:26257/defaultdb?sslmode=verify-full

# ───────────────────────────────────────────────────────
# Better Auth
# ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# ───────────────────────────────────────────────────────
# Google OAuth (optional)
# ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ───────────────────────────────────────────────────────
# TBO API (flights/hotels)
# ───────────────────────────────────────────────────────
TBO_USERNAME=your-tbo-username
TBO_PASSWORD=your-tbo-password
TBO_HOTEL_USERNAME=your-tbo-hotel-username
TBO_HOTEL_PASSWORD=your-tbo-hotel-password
TBO_ENDPOINT=https://affiliate.tektravels.com/HotelAPI
TBO_BOOKING_ENDPOINT=https://HotelBE.tektravels.com/hotelservice.svc/rest
TBO_STATIC_ENDPOINT=http://api.tbotechnology.in/TBOHolidays_HotelAPI

# ───────────────────────────────────────────────────────
# Payment (optional)
# ───────────────────────────────────────────────────────
PAYMENT_GATEWAY=mock
PAYMENT_MOCK=true
