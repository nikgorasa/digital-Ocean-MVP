# ═══════════════════════════════════════════════════════
# GoRASA CockroachDB Standalone — Environment Variables
# ═══════════════════════════════════════════════════════
#
# TWO ISOLATED DATABASE ENVIRONMENTS:
#   DEV  → .env.local      (local dev + cckr.vercel.app)
#   PROD → .env.production  (project-yidb6.vercel.app)
#
# Each environment MUST use a DIFFERENT CockroachDB cluster
# to ensure complete data isolation.

# ───────────────────────────────────────────────────────
# CockroachDB — DEV Cluster
# ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@dev-cluster:26257/defaultdb?sslmode=verify-full
DIRECT_URL=postgresql://user:password@dev-cluster:26257/defaultdb?sslmode=verify-full

# ───────────────────────────────────────────────────────
# Better Auth
# ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# ───────────────────────────────────────────────────────
# Google OAuth (optional)
# ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ───────────────────────────────────────────────────────
# TBO API — flights
# ───────────────────────────────────────────────────────

# ───────────────────────────────────────────────────────
# TBO Hotel API — Search/PreBook/Book (production)
# Uses: affiliate.tektravels.com/HotelAPI
# ───────────────────────────────────────────────────────
TBO_USERNAME=RasaT
TBO_PASSWORD=RasaT@123
TBO_ENDPOINT=https://affiliate.tektravels.com/HotelAPI
TBO_BOOKING_ENDPOINT=https://affiliate.tektravels.com/HotelAPI

# ───────────────────────────────────────────────────────
# TBO Hotel API — Static Data (staging)
# Uses: api.tbotechnology.in/TBOHolidays_HotelAPI
# Endpoints: CountryList, CityList, TBOHotelCodeList, HotelDetails
# NOTE: City codes from this staging endpoint DIFFER from production search codes.
# ───────────────────────────────────────────────────────
TBO_HOTEL_USERNAME=TBOStaticAPITest
TBO_HOTEL_PASSWORD=Tbo@11530818
TBO_STATIC_ENDPOINT=http://api.tbotechnology.in/TBOHolidays_HotelAPI

# Force mock mode (set to "true" to use mock data without API calls)
TBO_HOTEL_FORCE_MOCK=

# ───────────────────────────────────────────────────────
# Payment — Zaakpay Payment Gateway
# ───────────────────────────────────────────────────────
PAYMENT_GATEWAY=zaakpay
PAYMENT_MOCK=true
ZAAKPAY_MERCHANT_ID=your-merchant-id
ZAAKPAY_SECRET_KEY=your-secret-key
ZAAKPAY_SALT=your-salt-key
ZAAKPAY_API_BASE=https://sandbox.zaakpay.com

# ───────────────────────────────────────────────────────
# Config Encryption Key
# Used by ConfigProvider to encrypt stored credentials via AES-256-GCM
# MUST be unique per environment — do NOT reuse DEV key in PROD
# ───────────────────────────────────────────────────────
CONFIG_ENCRYPTION_KEY=your-unique-32-char-min-key
